# Copie ce fichier en .env.local et renseigne tes vraies valeurs.
# Ne jamais committer .env.local. Les vraies clés vivent dans les
# variables d'environnement de l'hébergeur (Vercel, Netlify), pas dans le dépôt.

# Supabase (exposées au navigateur, c'est normal pour ces deux-là)
NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta_cle_anon_publique

# Mistral (STRICTEMENT serveur, jamais de prefixe NEXT_PUBLIC_)
MISTRAL_API_KEY=ta_cle_mistral_secrete
